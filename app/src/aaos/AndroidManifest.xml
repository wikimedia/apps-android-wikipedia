    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <application
        android:appCategory="productivity">

        <meta-data
            android:name="@string/preference_key_app_channel"
            android:value="Automotive"
            tools:replace="android:value" />

        <activity
            android:name=".games.onthisday.OnThisDayGameActivity"
            tools:remove="android:screenOrientation" />

        <activity
            android:name=".createaccount.CreateAccountEncourageActivity"
            tools:remove="android:screenOrientation" />

        <activity
            android:name=".donate.donationreminder.DonationReminderActivity"
